# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3005

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/ephemeral_chat
# Optional: used by the integration test suite instead of an in-memory server
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/ephemeral_chat_test

# ---------------------------------------------------------------------------
# Authentication
# Generate a strong secret, e.g.  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------------------------------------
# CORS - comma separated list of allowed browser origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3006,http://127.0.0.1:3006

# ---------------------------------------------------------------------------
# Channel rules
# ---------------------------------------------------------------------------
CHANNEL_MAX_DURATION_MINUTES=60
CHANNEL_MIN_DURATION_MINUTES=1
# How many live channels one user may own at the same time
CHANNEL_MAX_ACTIVE_PER_USER=4
# How long before expiry the "channel is about to be deleted" warning is sent
CHANNEL_EXPIRY_WARNING_SECONDS=60
# How often the expiration sweeper runs (ms)
CHANNEL_SWEEP_INTERVAL_MS=1000

# ---------------------------------------------------------------------------
# WebSocket
# Off by default: Vercel (serverless) cannot hold sockets. Clients then poll
# over HTTP. Set to true only on a long-running host (`npm start`).
# ---------------------------------------------------------------------------
WS_ENABLED=false
WS_PATH=/ws
# A socket must authenticate within this window or it is closed
WS_AUTH_TIMEOUT_MS=10000
WS_HEARTBEAT_INTERVAL_MS=30000
# Per-connection inbound message budget
WS_RATE_LIMIT_WINDOW_MS=10000
WS_RATE_LIMIT_MAX_EVENTS=60

# ---------------------------------------------------------------------------
# Attachments
# Files are only ever served through an authorisation-checking endpoint.
# STORAGE_DRIVER=mongo stores bytes in MongoDB (no disk writes - required on
# Vercel); `local` writes to UPLOAD_DIR. ATTACHMENTS_ENABLED=false turns
# uploads off entirely.
# Vercel rejects request bodies over 4.5 MB, so keep both limits below that.
# ---------------------------------------------------------------------------
ATTACHMENTS_ENABLED=true
STORAGE_DRIVER=mongo
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_IMAGE_BYTES=4194304
UPLOAD_MAX_FILE_BYTES=4194304
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=30

# ---------------------------------------------------------------------------
# HTTP rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
# Set to true behind a proxy (Vercel), so rate limits key on the real client IP
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Logging: error | warn | info | debug
# ---------------------------------------------------------------------------
LOG_LEVEL=info
